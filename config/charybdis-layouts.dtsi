#include <physical_layouts.dtsi>

/ {
    charybdis_physical_layout: charybdis_physical_layout {
        compatible = "zmk,physical-layout";
        display-name = "Charybdis 3x6";
        status = "okay";
        kscan = <&kscan0>;
        transform = <&default_transform>;

        keys
            // Left Half - Main Keys
            //                       w   h    x    y     rot    rx    ry
            = <&key_physical_attrs 100 100    0   38       0     0     0>
            , <&key_physical_attrs 100 100  100   38       0     0     0>
            , <&key_physical_attrs 100 100  200   12       0     0     0>
            , <&key_physical_attrs 100 100  300    0       0     0     0>
            , <&key_physical_attrs 100 100  400   12       0     0     0>
            , <&key_physical_attrs 100 100  500   12       0     0     0>
            , <&key_physical_attrs 100 100  900   12       0     0     0>
            , <&key_physical_attrs 100 100 1000   12       0     0     0>
            , <&key_physical_attrs 100 100 1100    0       0     0     0>
            , <&key_physical_attrs 100 100 1200   12       0     0     0>
            , <&key_physical_attrs 100 100 1300   38       0     0     0>
            , <&key_physical_attrs 100 100 1400   38       0     0     0>
            , <&key_physical_attrs 100 100    0  138       0     0     0>
            , <&key_physical_attrs 100 100  100  138       0     0     0>
            , <&key_physical_attrs 100 100  200  112       0     0     0>
            , <&key_physical_attrs 100 100  300  100       0     0     0>
            , <&key_physical_attrs 100 100  400  112       0     0     0>
            , <&key_physical_attrs 100 100  500  112       0     0     0>

            // Right Half - Main Keys
            //                       w   h    x    y     rot    rx    ry
            , <&key_physical_attrs 100 100  900  112       0     0     0>
            , <&key_physical_attrs 100 100 1000  112       0     0     0>
            , <&key_physical_attrs 100 100 1100  100       0     0     0>
            , <&key_physical_attrs 100 100 1200  112       0     0     0>
            , <&key_physical_attrs 100 100 1300  138       0     0     0>
            , <&key_physical_attrs 100 100 1400  138       0     0     0>
            , <&key_physical_attrs 100 100    0  238       0     0     0>
            , <&key_physical_attrs 100 100  100  238       0     0     0>
            , <&key_physical_attrs 100 100  200  212       0     0     0>
            , <&key_physical_attrs 100 100  300  200       0     0     0>
            , <&key_physical_attrs 100 100  400  212       0     0     0>
            , <&key_physical_attrs 100 100  500  212       0     0     0>
            , <&key_physical_attrs 100 100  900  212       0     0     0>
            , <&key_physical_attrs 100 100 1000  212       0     0     0>
            , <&key_physical_attrs 100 100 1100  200       0     0     0>
            , <&key_physical_attrs 100 100 1200  212       0     0     0>
            , <&key_physical_attrs 100 100 1300  238       0     0     0>
            , <&key_physical_attrs 100 100 1400  238       0     0     0>

            // Thumb Clusters
            //                       w   h    x    y     rot    rx    ry
            , <&key_physical_attrs 100 100  348  314       0     0     0>
            , <&key_physical_attrs 100 100  348  314    1500   398   790>
            , <&key_physical_attrs 100 100  348  320    3000   398   790>
            , <&key_physical_attrs 100 100 1052  320 (-3000)  1102   790>
            , <&key_physical_attrs 100 100 1052  314 (-1500)  1102   790>
            ;
    };

    vendor_3x5_physical_layout: vendor_3x5_physical_layout {
        compatible = "zmk,physical-layout";
        display-name = "Vendor 3x5";
        status = "okay";
        kscan = <&kscan0>;
        transform = <&vendor_3x5_transform>;

        keys
            // Left Half - Main Keys (3x5)
            //                       w   h    x    y     rot    rx    ry
            = <&key_physical_attrs 100 100  100   12       0     0     0>   // Q
            , <&key_physical_attrs 100 100  200   12       0     0     0>   // W
            , <&key_physical_attrs 100 100  300    0       0     0     0>   // E
            , <&key_physical_attrs 100 100  400   12       0     0     0>   // R
            , <&key_physical_attrs 100 100  500   12       0     0     0>   // T
            , <&key_physical_attrs 100 100 1000   12       0     0     0>   // Y
            , <&key_physical_attrs 100 100 1100    0       0     0     0>   // U
            , <&key_physical_attrs 100 100 1200   12       0     0     0>   // I
            , <&key_physical_attrs 100 100 1300   12       0     0     0>   // O
            , <&key_physical_attrs 100 100 1400   12       0     0     0>   // P
            , <&key_physical_attrs 100 100  100  112       0     0     0>   // A
            , <&key_physical_attrs 100 100  200  112       0     0     0>   // S
            , <&key_physical_attrs 100 100  300  100       0     0     0>   // D
            , <&key_physical_attrs 100 100  400  112       0     0     0>   // F
            , <&key_physical_attrs 100 100  500  112       0     0     0>   // G
            , <&key_physical_attrs 100 100 1000  112       0     0     0>   // H
            , <&key_physical_attrs 100 100 1100  100       0     0     0>   // J
            , <&key_physical_attrs 100 100 1200  112       0     0     0>   // K
            , <&key_physical_attrs 100 100 1300  112       0     0     0>   // L
            , <&key_physical_attrs 100 100 1400  112       0     0     0>   // '
            , <&key_physical_attrs 100 100  100  212       0     0     0>   // Z
            , <&key_physical_attrs 100 100  200  212       0     0     0>   // X
            , <&key_physical_attrs 100 100  300  200       0     0     0>   // C
            , <&key_physical_attrs 100 100  400  212       0     0     0>   // V
            , <&key_physical_attrs 100 100  500  212       0     0     0>   // B
            , <&key_physical_attrs 100 100 1000  212       0     0     0>   // N
            , <&key_physical_attrs 100 100 1100  200       0     0     0>   // M
            , <&key_physical_attrs 100 100 1200  212       0     0     0>   // ,
            , <&key_physical_attrs 100 100 1300  212       0     0     0>   // .
            , <&key_physical_attrs 100 100 1400  212       0     0     0>   // /

            // Thumb Clusters (3 left, 2 right)
            //                       w   h    x    y     rot    rx    ry
            , <&key_physical_attrs 100 100  248  314       0     0     0>   // ESC (left thumb 1)
            , <&key_physical_attrs 100 100  348  314       0     0     0>   // SPC (left thumb 2)
            , <&key_physical_attrs 100 100  448  320       0     0     0>   // TAB (left thumb 3)
            , <&key_physical_attrs 100 100 1052  320       0     0     0>   // ENT (right thumb 1)
            , <&key_physical_attrs 100 100 1152  314       0     0     0>   // BSP (right thumb 2)
            ;
    };
};
